# Copy to .env.local and fill in with your own Firebase project's web config.
# Firebase web config values identify the project; they are not secrets, but this repo
# keeps them out of version control so every deployment uses its own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key registered with Firebase App Check (score-based, no checkbox).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Set to "true" only on a development machine. The SDK prints a debug token in the console;
# register it under App Check > Manage debug tokens. Never commit a debug token.
VITE_APPCHECK_DEBUG=false
